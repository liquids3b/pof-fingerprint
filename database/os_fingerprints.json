{
  "format": "pof-db/1",
  "origin": "own hand written profiles plus entries imported by tools/import_db.py from p0f.fp (Michal Zalewski, GNU LGPL); no proprietary fingerprint table is redistributed here",
  "how_to_tune": "entries are weighted by n (sessions); learn from your own captures with tools/build_db.py, or convert a foreign table with tools/import_db.py - see README.md",
  "field_help": {
    "os": "label returned by the API",
    "n": "how many sessions of real traffic this profile stands for; sets its weight",
    "tcp_options": "canonical option string of the SYN, see src/tcp_opts.py",
    "tcp_options_ordered": "optional; derived from tcp_options when missing",
    "tcp_data_offset": "TCP data offset in 32 bit words (5 = no options)",
    "ip_total_length": "IPv4 total length of the bare SYN (IP + TCP + options)",
    "ip_ttl_initial": "TTL the sender most likely started with (64, 128, 255)",
    "tcp_window_size": "window size announced in the SYN",
    "tcp_window_scaling": "window scale value, null when the option is absent",
    "tcp_mss": "maximum segment size option, null when absent",
    "ip_id_zero": "1 when the IPv4 identification field is zero, 0 when not, null when unknown",
    "tcp_timestamp": "1 when the SYN carries a timestamp option, null when unknown",
    "tcp_timestamp_echo": "value the timestamp echo field carries (always 0 in a SYN)",
    "ip_tos": "IPv4 type of service byte",
    "tcp_flags": "TCP flags of the SYN (0x02 = SYN only)",
    "source": "where the profile came from: 'hand written' or the table it was imported from",
    "note": "free text, ignored by the scorer"
  },
